# Matlab
*.autosave
*.slxc

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumps.db
*.swp
build.info

# Build directories
build*
docs/_build/
# Exception: documentation files whose names start with "build"
!docs/**/build_*.rst
# Exception: VS Code extension sources whose names start with "build"
!vscode-plugin/scripts/build.sh
!vscode-plugin/src/core/buildEnv.ts
images*
bin*
.Xil*
.obj*
.ipynb_checkpoints*
*.jou
slprj*
linux*
.nfs*

# Only .bit.gz and .mcs.gz should be committed to git
*.bit
*.mcs
*.gz
*.ltx
*.hdf
*.vho
*.zip
*.xsa
*.pdi
*.bif
*.elf

# AI Agents
.vscode/
.cursor/
.claude/
.gsd/
.planning/
planning/
CLAUDE.md
# Exception: launch configuration of the VS Code extension
!vscode-plugin/.vscode/

# Regression harness clones and artifacts
/surf/
/ruckus/
tests/sim_build/
.pytest_cache/
results.xml
.coverage*
.venv/

# Exceptions: new tests/ and docs/ files must never be swallowed by the generic patterns above.
# tests/ghdl/images is generated by make import, so no images* exception under tests/.
!tests/**/build*
!tests/**/build*/
!tests/**/bin*
!tests/**/bin*/
!tests/**/linux*
!tests/**/linux*/
!tests/**/*.dat
!tests/**/*.log
!docs/**/build*
!docs/**/build*/
!docs/**/bin*
!docs/**/bin*/
!docs/**/images*
!docs/**/images*/
!docs/**/linux*
!docs/**/linux*/
